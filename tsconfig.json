{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./jeu/src/*"
      ],
      "@config/*": [
        "./jeu/config/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jeu/src/app",
    "jeu/src/components",
    "jeu/src/stories",
    "jeu/src/lib/auth",
    "jeu/src/lib/db",
    "jeu/src/lib/pay"
  ]
}
