{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./jeu/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jeu/components",
    "jeu/lib/game/grant.ts",
    "jeu/lib/game/raid-events.ts",
    "jeu/lib/leaderboard.ts"
  ]
}
